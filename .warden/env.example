# Copied to .env by scripts/db-setup.sh, which fills in the passwords. .env is git-ignored.
WARDEN_ENV_NAME=fretwise
WARDEN_ENV_TYPE=local
TRAEFIK_DOMAIN=fretwise.test
TRAEFIK_SUBDOMAIN=app
# Warden starts ElasticHQ unless told not to; Fretwise needs only the database.
WARDEN_ELASTICHQ=0
MARIADB_VERSION=11.4
FRETWISE_DB_PORT=3316
MYSQL_DATABASE=fretwise
MYSQL_USER=fretwise
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
